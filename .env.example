# ========================
# ATS Resume Builder — Environment Variables
# ========================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Django ---
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,yourdomain.com

# --- Database ---
# SQLite (local dev — no extra config needed)
# PostgreSQL (production — use Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Google OAuth & Drive ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: https://yourdomain.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- OpenRouter AI ---
# Get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# --- Email (optional — uses console backend if not set) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# --- App Limits ---
AI_MAX_REQUESTS_PER_DAY=50
RESUME_MAX_PER_USER=20

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
